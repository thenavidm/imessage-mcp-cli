{
  "name": "@thenavidm/imessage-mcp-cli",
  "version": "0.3.0",
  "description": "iMessage MCP server and CLI for Claude Code, Codex and AI agents on a Mac. 10 tools for an inbox that survives restarts, search across your full history, contact lookup, sending with delivery confirmation, and voice note transcription.",
  "type": "module",
  "bin": {
    "imessage-mcp": "dist/index.js",
    "imessage-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "doctor": "node dist/index.js doctor",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "imessage",
    "messages",
    "macos",
    "sms",
    "claude",
    "claude-code",
    "claude-desktop",
    "ai-agents",
    "typescript",
    "cli",
    "command-line-tool"
  ],
  "author": "Navid Moazzez (https://navid.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/imessage-mcp-cli.git"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "homepage": "https://navid.me",
  "bugs": {
    "url": "https://github.com/thenavidm/imessage-mcp-cli/issues"
  }
}
